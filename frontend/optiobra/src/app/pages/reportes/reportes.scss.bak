.reportes-container {
  padding: 30px;
  background: #f5f7fa;
  min-height: 100vh;

  h2 {
    color: #1f3b73;
    margin-bottom: 25px;
    font-size: 28px;
    font-weight: bold;
  }
}

.filtros {
  background: #ffffff;
  border-radius: 12px;
  padding: 20px;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 20px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  margin-bottom: 30px;
}

.campo {
  display: flex;
  flex-direction: column;
}

.campo label {
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 8px;
  color: #444;
}

.campo input,
.campo select {
  height: 42px;
  border: 1px solid #dcdcdc;
  border-radius: 8px;
  padding: 0 12px;
  font-size: 14px;
  outline: none;
}

.campo input:focus,
.campo select:focus {
  border-color: #0d6efd;
}

.boton-generar {
  display: flex;
  align-items: end;
}

.boton-generar button {
  width: 100%;
  height: 42px;
  background: #0d6efd;
  color: white;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  font-weight: bold;
  transition: .3s;
}

.boton-generar button:hover {
  background: #0b5ed7;
}

.cards {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  margin-bottom: 30px;
}

.card {
  background: white;
  border-radius: 12px;
  padding: 20px;
  text-align: center;
  box-shadow: 0 2px 8px rgba(0,0,0,.08);
}

.card h3 {
  font-size: 30px;
  color: #0d6efd;
  margin-bottom: 10px;
}

.card p {
  color: #666;
  font-size: 15px;
}

.graficas {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 20px;
  margin-bottom: 30px;
}

.grafica {
  background: white;
  border-radius: 12px;
  padding: 20px;
  box-shadow: 0 2px 8px rgba(0,0,0,.08);
}

.grafica h3 {
  margin-bottom: 20px;
  color: #1f3b73;
}

.placeholder {
  height: 300px;
  border: 2px dashed #cfcfcf;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: gray;
  font-size: 16px;
}

.exportar {
  display: flex;
  justify-content: flex-end;
  gap: 15px;
}

.exportar button {
  padding: 12px 25px;
  border: none;
  border-radius: 8px;
  color: white;
  cursor: pointer;
  font-weight: bold;
  transition: .3s;
}

.exportar button:first-child {
  background: #dc3545;
}

.exportar button:last-child {
  background: #198754;
}

.exportar button:hover {
  opacity: 0.9;
}

@media (max-width: 992px) {

  .filtros {
    grid-template-columns: repeat(2, 1fr);
  }

  .cards {
    grid-template-columns: repeat(2, 1fr);
  }

  .graficas {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 576px) {

  .filtros,
  .cards {
    grid-template-columns: 1fr;
  }

  .exportar {
    flex-direction: column;
  }

  .exportar button {
    width: 100%;
  }
}
# Stage 1: Build Frontend Angular
FROM node:20-alpine AS frontend-builder

WORKDIR /build/frontend

COPY frontend/optiobra/package*.json ./
RUN npm ci

COPY frontend/optiobra/ ./
RUN npm run build

# Stage 2: Final image (Nginx + cloudflared)
FROM debian:bookworm-slim

LABEL maintainer="OptiObra Team"
LABEL description="OptiObra - Frontend Angular (nginx) con soporte de tuneles Cloudflare (cloudflared)"
LABEL version="1.0.0"

ENV DEBIAN_FRONTEND=noninteractive

# Instalar nginx y descargar cloudflared para exponer la SPA sin abrir puertos
RUN apt-get update && apt-get install -y --no-install-recommends \
    nginx \
    curl \
    wget \
    ca-certificates \
    && wget -qO /usr/local/bin/cloudflared https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64 \
    && chmod +x /usr/local/bin/cloudflared \
    && rm -rf /var/lib/apt/lists/*

# Copy compiled frontend
COPY --from=frontend-builder /build/frontend/dist/optiobra/browser/ /var/www/html/

# Copy nginx config
COPY docker/nginx.conf /etc/nginx/nginx.conf
COPY docker/nginx-frontend.conf /etc/nginx/conf.d/default.conf

# Remove Debian's default site (conflicts with our default_server)
RUN rm -f /etc/nginx/sites-enabled/default

# Copy startup script
COPY docker/start_frontend_ptero.sh /app/start_frontend_ptero.sh
RUN chmod +x /app/start_frontend_ptero.sh

# Create writable directories (Pterodactyl puede montar el root read-only)
RUN mkdir -p \
    /home/container/logs \
    /tmp/nginx_temp \
    && chmod 755 /var/www/html

# Expose ports
EXPOSE 80 443

# Health check (nginx sirve /health/)
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost/health/ || exit 1

# Start script (compatible con Pterodactyl startup command)
CMD ["/app/start_frontend_ptero.sh"]